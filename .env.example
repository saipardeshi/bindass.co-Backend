# Copy to .env (git-ignored) and fill in. Real environment variables override these.
server.port=5000
app.client-url=http://localhost:5173

spring.data.mongodb.uri=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
# openssl rand -base64 48   (>= 32 chars, not a placeholder — the app won't start otherwise)
app.jwt.secret=
app.jwt.expiration=86400000

razorpay.key-id=
razorpay.key-secret=

cloudinary.cloud-name=
cloudinary.api-key=
cloudinary.api-secret=

spring.mail.username=
spring.mail.password=
app.email.from=

# true = insert the starter catalog on startup (idempotent). Leave false in production.
app.seed.enabled=false
# creates the FIRST admin if none exists (password >= 10 chars). Remove after first start.
app.admin.email=
app.admin.password=
# true only when behind your own reverse proxy that sets X-Forwarded-For
app.rate-limit.trust-proxy=false
